# --- Operational DB (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://wfi:wfi@localhost:5432/workforce_intelligence

# --- Analytical DB (ClickHouse) ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=workforce_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Cache / pubsub (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Workflow (Temporal) ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=workforce-intelligence

# --- Object storage (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wfi-resumes

# --- Auth (Clerk) — leave blank to use the dev mock adapter ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Email ---
SENDGRID_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=outreach@local

# --- SMS / Voice (no free tier — leave blank to keep adapters in mock mode) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VAPI_API_KEY=
RETELL_API_KEY=

# --- Calendar (Google — free OAuth) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Enrichment (no free tier — adapters stay mock without these) ---
APOLLO_API_KEY=
ZOOMINFO_API_KEY=

# --- Federal contract intelligence (no free tier) ---
GOVWIN_API_KEY=
BGOV_API_KEY=

# --- ATS (Greenhouse has a free Harvest API tier with developer accounts) ---
GREENHOUSE_HARVEST_API_KEY=
GREENHOUSE_INGESTION_API_KEY=

# --- Encryption ---
SECRET_ENCRYPTION_KEY=v1:dev_only_secret_at_least_32_characters_x

# --- App config ---
ENV=development
LOG_LEVEL=INFO
PORT_RULES=8001
PORT_SCREENING=8002
PORT_OUTREACH=8003
PORT_PIPELINE=8004
PORT_CLIENT_ADVISORY=8005
PORT_INTERVIEW=8006
PORT_CAPTURE=8007
PORT_OUTCOMES=8008
PORT_BENCH=8009
PORT_MARKET=8010
PORT_COMMAND_CENTER=3000
PORT_CANDIDATE_PORTAL=3001
